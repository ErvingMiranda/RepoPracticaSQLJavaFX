<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="710.0" prefWidth="980.0" stylesheets="@../estilos/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.registroempleados.controller.EmpleadoController">
   <children>
      <!-- Título Principal -->
      <Label layoutX="25.0" layoutY="20.0" styleClass="titulo" text="REGISTRO DE EMPLEADOS" />
      <Separator layoutX="25.0" layoutY="50.0" prefWidth="930.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" />

      <!-- Columna Izquierda de Campos -->
      <Label fx:id="lblNombres" layoutX="35.0" layoutY="70.0" styleClass="label-campo" text="Nombres:" />
      <TextField fx:id="txtNombres" layoutX="175.0" layoutY="65.0" prefHeight="30.0" prefWidth="280.0" promptText="Ej: Roger Marcel" />

      <Label fx:id="lblCedula" layoutX="35.0" layoutY="110.0" styleClass="label-campo" text="Cédula:" />
      <TextField fx:id="txtCedula" layoutX="175.0" layoutY="105.0" prefHeight="30.0" prefWidth="280.0" promptText="001-000000-0000X" />

      <Label fx:id="lblTelefono" layoutX="35.0" layoutY="150.0" styleClass="label-campo" text="Teléfono:" />
      <TextField fx:id="txtTelefono" layoutX="175.0" layoutY="145.0" prefHeight="30.0" prefWidth="280.0" promptText="8888-8888" />

      <Label fx:id="lblDepartamento" layoutX="35.0" layoutY="190.0" styleClass="label-campo" text="Departamento:" />
      <ComboBox fx:id="cmbDepartamento" layoutX="175.0" layoutY="185.0" prefHeight="30.0" prefWidth="280.0" promptText="Seleccione..." />

      <Label fx:id="lblFecha" layoutX="35.0" layoutY="230.0" styleClass="label-campo" text="Fecha contratación:" />
      <DatePicker fx:id="dpFechaContratacion" layoutX="175.0" layoutY="225.0" prefHeight="30.0" prefWidth="280.0" promptText="Seleccionar fecha" />

      <!-- Columna Derecha de Campos -->
      <Label fx:id="lblApellidos" layoutX="510.0" layoutY="70.0" styleClass="label-campo" text="Apellidos:" />
      <TextField fx:id="txtApellidos" layoutX="640.0" layoutY="65.0" prefHeight="30.0" prefWidth="280.0" promptText="Ej: Sequeira Espinoza" />

      <Label fx:id="lblCorreo" layoutX="510.0" layoutY="110.0" styleClass="label-campo" text="Correo:" />
      <TextField fx:id="txtCorreo" layoutX="640.0" layoutY="105.0" prefHeight="30.0" prefWidth="280.0" promptText="usuario@empresa.com" />

      <Label fx:id="lblCargo" layoutX="510.0" layoutY="150.0" styleClass="label-campo" text="Cargo:" />
      <TextField fx:id="txtCargo" layoutX="640.0" layoutY="145.0" prefHeight="30.0" prefWidth="280.0" promptText="Ej: Analista" />

      <Label fx:id="lblSalario" layoutX="510.0" layoutY="190.0" styleClass="label-campo" text="Salario:" />
      <TextField fx:id="txtSalario" layoutX="640.0" layoutY="185.0" prefHeight="30.0" prefWidth="280.0" promptText="0.00" />

      <Label fx:id="lblEstado" layoutX="510.0" layoutY="230.0" styleClass="label-campo" text="Estado:" />
      <ComboBox fx:id="cmbEstado" layoutX="640.0" layoutY="225.0" prefHeight="30.0" prefWidth="280.0" promptText="Activo / Inactivo" />

      <Label fx:id="lblConsulta" layoutX="512.0" layoutY="327.0" styleClass="label-campo" text="Consulta:" />
      <ComboBox fx:id="cmbConsulta" layoutX="581.0" layoutY="319.0" onAction="#cargarEmpleados" prefHeight="32.0" prefWidth="280.0" promptText="Seleccionar consulta..." />

      <!-- Botones de Acción -->
      <Button fx:id="btnGuardar" layoutX="39.0" layoutY="275.0" onAction="#guardarEmpleado" prefHeight="32.0" prefWidth="90.0" styleClass="btn-primary" text="Guardar" />
      <Button fx:id="btnActualizar" layoutX="139.0" layoutY="274.0" onAction="#actualizarEmpleado" prefHeight="32.0" prefWidth="110.0" styleClass="btn-info" text="Actualizar" />
      <Button fx:id="btnEliminar" layoutX="259.0" layoutY="274.0" onAction="#eliminarEmpleado" prefHeight="32.0" prefWidth="100.0" styleClass="btn-danger" text="Eliminar" />      <Button fx:id="btnLimpiar" layoutX="369.0" layoutY="274.0" onAction="#limpiarCampos" prefHeight="32.0" prefWidth="95.0" styleClass="btn-secondary" text="Limpiar" />
      <Button fx:id="btnActualizarTabla" layoutX="474.0" layoutY="274.0" onAction="#actualizarTabla" prefHeight="32.0" prefWidth="135.0" styleClass="btn-info" text="Actualizar tabla" />

      <!-- Sección de la Tabla -->
      <Label layoutX="25.0" layoutY="335.0" styleClass="titulo" text="EMPLEADOS REGISTRADOS" />

      <TableView fx:id="tblEmpleados" layoutX="25.0" layoutY="365.0" prefHeight="325.0" prefWidth="930.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="365.0">
         <columns>
            <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />
            <TableColumn fx:id="colNombres" prefWidth="110.0" text="Nombres" />
            <TableColumn fx:id="colApellidos" prefWidth="110.0" text="Apellidos" />
            <TableColumn fx:id="colCedula" prefWidth="110.0" text="Cédula" />
            <TableColumn fx:id="colCorreo" prefWidth="130.0" text="Correo" />
            <TableColumn fx:id="colTelefono" prefWidth="85.0" text="Teléfono" />
            <TableColumn fx:id="colCargo" prefWidth="105.0" text="Cargo" />
            <TableColumn fx:id="colDepartamento" prefWidth="110.0" text="Departamento" />
            <TableColumn fx:id="colSalario" prefWidth="75.0" text="Salario" />
            <TableColumn fx:id="colFechaContratacion" prefWidth="100.0" text="F. Contratación" />
            <TableColumn fx:id="colEstado" prefWidth="65.0" text="Estado" />
         </columns>
      </TableView>
   </children>
</AnchorPane>
